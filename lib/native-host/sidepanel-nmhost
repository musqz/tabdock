#!/usr/bin/env python3
"""Native-messaging relay between the browser extension and the panel.

The browser spawns this (one process per browser instance). It speaks native
messaging on stdio (4-byte native-endian length + JSON) and line-delimited JSON
on the panel's Unix socket. It waits for the panel to appear, and every time the
panel (re)connects it asks the extension to "resync" so the panel gets a
fresh hello + state.

If no panel is running when the relay starts, it starts one (detached), so opening
a browser with the extension is enough. If that panel dies before it ever listens
(crashed, or lost a race with another starting panel) it is started again, at most
MAX_LAUNCHES times in all. Once this relay has seen a panel it never starts one
again, so a panel quit with its X button stays quit.
"""
import json
import os
import select
import shlex
import socket
import struct
import subprocess
import sys
import tomllib

# deliberately standalone (one copyable file); keep in sync with sidepanel/config.py socket_path()
SOCKET = os.environ.get("SIDEPANEL_SOCKET") or os.path.join(
    os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "openbox-sidepanel.sock"
)
RETRY_S = 1.0
MAX_LAUNCHES = 3


def to_browser(obj):
    data = json.dumps(obj, separators=(",", ":")).encode()
    try:
        sys.stdout.buffer.write(struct.pack("=I", len(data)) + data)
        sys.stdout.buffer.flush()
    except BrokenPipeError:
        sys.exit(0)


def drop_panel(sock):
    """Panel went away: tell the extension so it stops building snapshots nobody reads."""
    sock.close()
    to_browser({"type": "panel_disconnected"})
    return None


def connect_panel():
    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    try:
        s.connect(SOCKET)
    except OSError:
        s.close()
        return None
    return s


def launch_enabled():
    """start_with_browser from config.toml (default true). SIDEPANEL_NO_LAUNCH=1 turns it off (tests)."""
    if os.environ.get("SIDEPANEL_NO_LAUNCH"):
        return False
    path = os.path.join(
        os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config"), "openbox-sidepanel", "config.toml"
    )
    try:
        with open(path, "rb") as f:
            return tomllib.load(f).get("start_with_browser", True) is not False
    except (OSError, ValueError):
        return True  # no or unreadable config: keep the default; the panel reports config errors itself


def start_panel():
    """Start the panel detached from this relay and from the browser, so it outlives both.

    Its stdio must never be ours: stdout is the native-messaging channel to the browser.
    Returns the Popen (kept only to reap it and to notice it dying), or None if nothing could be run.
    """
    override = os.environ.get("SIDEPANEL_PANEL_CMD")  # a test hook
    cmd = shlex.split(override) if override else [
        os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "..", "sidepanel")
    ]
    log = os.path.join(os.environ.get("XDG_RUNTIME_DIR") or "/tmp", "openbox-sidepanel.log")
    try:
        with open(log, "ab") as out:
            return subprocess.Popen(
                cmd, stdin=subprocess.DEVNULL, stdout=out, stderr=out, start_new_session=True, close_fds=True
            )
    except OSError:
        return None  # nothing to run here; the panel can still be started by hand


def main():
    browser_pid = os.getppid()
    sock = None
    from_browser = b""
    from_panel = b""
    may_launch = True  # only while this relay has never seen a panel
    launches = 0
    panel_proc = None  # the panel we started, until it exits

    while True:
        if panel_proc is not None and panel_proc.poll() is not None:
            panel_proc = None  # exited: reaped here so it does not linger as a zombie
        if sock is None:
            sock = connect_panel()
            if sock is not None:
                may_launch = False
                from_panel = b""
                to_browser({"type": "resync"})
            elif may_launch and panel_proc is None:  # nothing running, and nothing of ours still starting
                if launches < MAX_LAUNCHES and launch_enabled():
                    launches += 1
                    panel_proc = start_panel()
                    may_launch = panel_proc is not None
                else:
                    may_launch = False

        # the timeout doubles as the panel reconnect interval
        ready, _, _ = select.select([0] + ([sock] if sock else []), [], [], RETRY_S)

        if 0 in ready:
            chunk = os.read(0, 65536)
            if not chunk:
                return  # browser closed the port
            from_browser += chunk
            while len(from_browser) >= 4:
                (size,) = struct.unpack("=I", from_browser[:4])
                if len(from_browser) < 4 + size:
                    break
                raw, from_browser = from_browser[4 : 4 + size], from_browser[4 + size :]
                if sock is None:
                    continue  # nobody listening; the resync on connect refreshes state
                try:
                    msg = json.loads(raw)
                except ValueError:
                    continue  # never let one bad message kill the relay
                if not isinstance(msg, dict):
                    continue
                if msg.get("type") == "hello":
                    msg["browserPid"] = browser_pid
                try:
                    sock.sendall(json.dumps(msg, separators=(",", ":")).encode() + b"\n")
                except OSError:
                    sock = drop_panel(sock)
                    break

        if sock is not None and sock in ready:
            try:
                chunk = sock.recv(65536)
            except OSError:
                chunk = b""
            if not chunk:
                sock = drop_panel(sock)
                continue
            from_panel += chunk
            *lines, from_panel = from_panel.split(b"\n")
            for line in lines:
                if not line:
                    continue
                try:
                    msg = json.loads(line)
                except ValueError:
                    continue
                if isinstance(msg, dict):
                    to_browser(msg)


if __name__ == "__main__":
    main()
